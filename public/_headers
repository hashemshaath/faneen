# Long-cache hashed Vite assets (filenames already include a content hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static brand & hero assets — paths are stable; bump filename to bust cache
/brand/*
  Cache-Control: public, max-age=31536000, immutable

/hero-bg.webp
  Cache-Control: public, max-age=31536000, immutable

/og-image.jpg
  Cache-Control: public, max-age=2592000

/logo.png
  Cache-Control: public, max-age=2592000

/pwa-192.png
  Cache-Control: public, max-age=2592000

/pwa-512.png
  Cache-Control: public, max-age=2592000

# Boot scripts — short cache so updates roll out quickly
/preload-hero.js
  Cache-Control: public, max-age=3600, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=3600, must-revalidate

# Service worker must always revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Conservative security headers applied site-wide.
# CSP / HSTS / COOP / Trusted Types intentionally omitted: they require
# coordinated rollout with GTM, Supabase, Google Fonts and the embed flows.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
