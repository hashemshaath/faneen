# Long-cache hashed Vite assets (filenames already include a content hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.jpg
  Cache-Control: public, max-age=2592000

/logo.png
  Cache-Control: public, max-age=2592000

/icons-48.png
  Cache-Control: public, max-age=2592000

/icons-96.png
  Cache-Control: public, max-age=2592000

/icons-144.png
  Cache-Control: public, max-age=2592000

/icons-192.png
  Cache-Control: public, max-age=2592000

/icons-512.png
  Cache-Control: public, max-age=2592000

# Service worker must always revalidate. Note: /registerSW.js and
# /preload-hero.js were removed (SW is now registered from src/main.tsx
# after load+idle, hero preload is injected by HomeV2.tsx) — their old
# entries were pruned from this file to avoid stale references.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Conservative security headers applied site-wide.
# CSP / HSTS / COOP / Trusted Types intentionally omitted: they require
# coordinated rollout with GTM, Supabase, Google Fonts and the embed flows.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
